# Microsoft Teams Configuration
# Get your webhook URL from Teams:
# 1. Go to your Teams channel
# 2. Click "..." next to channel name
# 3. Select "Connectors"
# 4. Add "Incoming Webhook"
# 5. Copy the webhook URL
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/your-webhook-id

# Optional: ServiceNow Configuration
# Configure these if you want to fetch tickets from ServiceNow automatically
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=airflow_notifier.log

# Optional: Airflow Configuration
# If you want to fetch DAG failure info from Airflow
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
